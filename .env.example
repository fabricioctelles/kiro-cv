# OpenAI-compatible API configuration
# Works with: OpenAI, OpenRouter, Azure, Groq, Together, local LLMs, etc.

# API Key (required)
OPENAI_API_KEY=

# Base URL (optional - defaults to OpenAI)
# OpenAI:      https://api.openai.com/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Groq:        https://api.groq.com/openai/v1
# Together:    https://api.together.xyz/v1
# Local:       http://localhost:11434/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model (optional - defaults to gpt-4o-mini)
# OpenAI:      gpt-4o, gpt-4o-mini, gpt-4-turbo
# OpenRouter:  anthropic/claude-sonnet-4, google/gemini-2.5-flash, meta-llama/llama-3-70b, openrouter/free
# Groq:        llama-3.1-70b-versatile, mixtral-8x7b-32768
# Together:    meta-llama/Llama-3-70b-chat-hf
OPENAI_MODEL=openrouter/free

# Chat language (optional - defaults to English)
# The AI will respond in this language by default
# Examples: en, pt-br, es, fr, de, it, ja, zh
LLM_CHAT_LANGUAGE=pt-br

# Optional: fetch resume.json from a URL at build time (falls back to local file)
# RESUME_URL=https://example.com/resume.json

# Google Analytics (optional)
# Get your Measurement ID from Google Analytics > Admin > Data Streams
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# ═══════════════════════════════════════════════════════════════════════════
# Telemetry (optional)
# ═══════════════════════════════════════════════════════════════════════════
# Log AI chat interactions (prompts, responses, tokens) to a local JSONL file.
# Useful for analytics and understanding what visitors ask about your CV.
#
# Note: Only works on environments with persistent filesystem (Coolify, VPS, Docker).
# On Vercel/serverless, the file will be lost between invocations.

# Enable telemetry logging (default: false)
TELEMETRY_ENABLED=false

# Path to the log file, relative to project root (default: logs/chat-telemetry.jsonl)
# TELEMETRY_FILE=logs/chat-telemetry.jsonl

# Maximum size per log file in MB before rotation (default: 10)
# TELEMETRY_MAX_SIZE_MB=10

# Number of rotated files to keep (default: 5)
# Files are named: chat-telemetry.jsonl, chat-telemetry.1.jsonl, ..., chat-telemetry.5.jsonl
# TELEMETRY_MAX_FILES=5
