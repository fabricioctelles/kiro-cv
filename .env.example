# OpenAI-compatible API configuration
# Works with: OpenAI, OpenRouter, Azure, Groq, Together, local LLMs, etc.

# API Key (required)
OPENAI_API_KEY=

# Base URL (optional - defaults to OpenAI)
# OpenAI:      https://api.openai.com/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Groq:        https://api.groq.com/openai/v1
# Together:    https://api.together.xyz/v1
# Local:       http://localhost:11434/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model (optional - defaults to gpt-4o-mini)
# OpenAI:      gpt-4o, gpt-4o-mini, gpt-4-turbo
# OpenRouter:  anthropic/claude-sonnet-4, google/gemini-2.5-flash, meta-llama/llama-3-70b, openrouter/free
# Groq:        llama-3.1-70b-versatile, mixtral-8x7b-32768
# Together:    meta-llama/Llama-3-70b-chat-hf
OPENAI_MODEL=openrouter/free

# Chat language (optional - defaults to English)
# The AI will respond in this language by default
# Examples: en, pt-br, es, fr, de, it, ja, zh
LLM_CHAT_LANGUAGE=pt-br

# Optional: fetch resume.json from a URL at build time (falls back to local file)
# RESUME_URL=https://example.com/resume.json
